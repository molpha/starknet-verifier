# Copy to .env and fill in before running scripts/deploy_testnet.sh
#
# Starknet address that will become protocol_admin (usually your deployer account).
PROTOCOL_ADMIN=0x...

# Optional: redundancy buffer passed to the Verifier constructor (default: 2).
REDUNDANCY_BUFFER=2

# Required: Starknet RPC URL (scripts and snfoundry.toml). Never commit API keys.
STARKNET_RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_KEY

# Optional: override snfoundry.toml profile (default: testnet).
# SNCAST_PROFILE=testnet

# Optional: override sncast account name from snfoundry.toml.
# SNCAST_ACCOUNT=deployer

# --- scripts/add_node.sh ---
# Deployed Verifier (see deployments/sepolia-*.txt after deploy_testnet.sh).
# VERIFIER_ADDRESS=0x...

# secp256k1 secret key for the node being registered (never commit real keys).
# NODE_PRIVATE_KEY=0x...

# Optional: 33-byte compressed pubkey; derived from NODE_PRIVATE_KEY if omitted.
# COMPRESSED_PUBKEY=0x02...
